# 🔐 Server Configuration
PORT=8080
HOST=0.0.0.0
ENV=development

# 🔑 Authentication
JWT_SECRET=your-jwt-secret # Generate using: openssl rand -base64 32
GITHUB_CLIENT_ID=your-github-client-id # Get from GitHub OAuth Apps
GITHUB_CLIENT_SECRET=your-github-client-secret # Get from GitHub OAuth Apps

# 💾 Backup Configuration (Cloudflare R2)
R2_ACCOUNT_ID=your-cloudflare-account-id # Your Cloudflare account ID
R2_ACCESS_KEY_ID=your-r2-access-key-id # Your R2 access key ID
R2_ACCESS_KEY_SECRET=your-r2-access-key-secret # Your R2 access key secret
R2_BUCKET_NAME=your-r2-bucket-name # Your R2 bucket name
BACKUP_INTERVAL=24h # Backup interval in duration format (e.g., 24h, 1h30m)

# 🔒 Security
TLS_CERT_PATH=/path/to/cert.pem # Optional: Path to TLS certificate
TLS_KEY_PATH=/path/to/key.pem # Optional: Path to TLS private key 

# 🌐 CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# 🌐 Frontend URL
GITHUB_REDIRECT_URL=http://localhost:8080/auth/github/callback

# 🔑 Wrap Key
XYPHOS_WRAP_KEY=your-wrap-key # 32 bytes of random data (e.g. openssl rand -hex 64)